# ============================================================
# Unity .gitignore — JumpGuy
# Unity 2022.3.22f1 (URP)
# ============================================================

# --- Unity generated folders ---------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# --- Autogenerated IDE files ---------------------------------
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.vscode/
.idea/
*.VC.VC.opendb

# --- Unity generated meta for the above ----------------------
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Crash reports -------------------------------------------
sysinfo.txt
crashlytics-build.properties

# --- Build artifacts -----------------------------------------
*.apk
*.aab
*.app
*_BurstDebugInformation_DoNotShip/
0.1vox.apk

# --- Large vendor source packages (excluded deliberately) ----
# Six .unitypackage files from the Layer Lab GUI pack carry PSD
# sources (~845 MB total). GitHub rejects files over 100 MB, and
# these are art sources, not needed to open or build the project.
# They stay on disk; re-download the asset to restore them.
/Assets/Layer Lab/**/PSD_*/*.unitypackage

# --- Local dev tooling ---------------------------------------
.dsh-unity-mcp/

# --- OS generated --------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
----------------------------------